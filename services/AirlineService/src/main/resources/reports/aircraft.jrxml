<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
        xmlns="http://jasperreports.sourceforge.net/jasperreports"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
        name="aircrafts"
        pageWidth="842"
        pageHeight="595"
        orientation="Landscape"
        columnWidth="782"
        leftMargin="30"
        rightMargin="30"
        topMargin="25"
        bottomMargin="25">

    <parameter name="REPORT_TITLE" class="java.lang.String"/>

    <field name="id" class="java.lang.Long"/>
    <field name="code" class="java.lang.String"/>
    <field name="model" class="java.lang.String"/>
    <field name="manufacturer" class="java.lang.String"/>
    <field name="seatingCapacity" class="java.lang.Integer"/>
    <field name="aircraftStatus" class="com.airlineportal.utils.Airline.AircraftStatus"/>
    <field name="isAvailable" class="java.lang.Boolean"/>
    <field name="currentAirportId" class="java.lang.Long"/>
    <field name="nextMaintenanceDate" class="java.time.LocalDate"/>
    <field name="totalSeats" class="java.lang.Integer"/>
    <field name="operational" class="java.lang.Boolean"/>

    <!-- ========================= -->
    <!-- TITLE + BAR CHART         -->
    <!-- ========================= -->
    <title>
        <band height="225">

            <rectangle>
                <reportElement x="0" y="0" width="782" height="62" backcolor="#1E3A5F"/>
            </rectangle>

            <staticText>
                <reportElement x="20" y="8" width="742" height="28" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="20" isBold="true"/>
                </textElement>
                <text><![CDATA[AIRCRAFT MANAGEMENT REPORT]]></text>
            </staticText>

            <staticText>
                <reportElement x="20" y="40" width="742" height="14" forecolor="#DCE8F5"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <text><![CDATA[Fleet, seating, availability and maintenance overview]]></text>
            </staticText>

            <staticText>
                <reportElement x="0" y="69" width="782" height="18" forecolor="#1E3A5F"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[SEATING CAPACITY BY AIRCRAFT]]></text>
            </staticText>

            <barChart>
                <chart evaluationTime="Report" isShowLegend="false">
                    <reportElement x="10" y="90" width="762" height="125"/>
                </chart>

                <categoryDataset>
                    <categorySeries>
                        <seriesExpression><![CDATA["Seats"]]></seriesExpression>
                        <categoryExpression><![CDATA[$F{code}]]></categoryExpression>
                        <valueExpression><![CDATA[$F{seatingCapacity} == null ? 0 : $F{seatingCapacity}]]></valueExpression>
                    </categorySeries>
                </categoryDataset>

                <barPlot
                        isShowLabels="true"
                        isShowTickMarks="true"
                        isShowTickLabels="true">
                    <plot/>
                    <categoryAxisLabelExpression><![CDATA["Aircraft Code"]]></categoryAxisLabelExpression>
                    <valueAxisLabelExpression><![CDATA["Seats"]]></valueAxisLabelExpression>
                </barPlot>
            </barChart>

        </band>
    </title>

    <!-- ========================= -->
    <!-- TABLE HEADER              -->
    <!-- ========================= -->
    <columnHeader>
        <band height="38">

            <staticText>
                <reportElement x="0" y="0" width="35" height="38" backcolor="#D9EAF7" forecolor="#000000"/>
                <box><pen lineWidth="0.7" lineColor="#D7E3EF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                <text><![CDATA[ID]]></text>
            </staticText>

            <staticText>
                <reportElement x="35" y="0" width="60" height="38" backcolor="#D9EAF7" forecolor="#000000"/>
                <box><pen lineWidth="0.7" lineColor="#D7E3EF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                <text><![CDATA[CODE]]></text>
            </staticText>

            <staticText>
                <reportElement x="95" y="0" width="105" height="38" backcolor="#D9EAF7" forecolor="#000000"/>
                <box><pen lineWidth="0.7" lineColor="#D7E3EF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                <text><![CDATA[MODEL]]></text>
            </staticText>

            <staticText>
                <reportElement x="200" y="0" width="105" height="38" backcolor="#D9EAF7" forecolor="#000000"/>
                <box><pen lineWidth="0.7" lineColor="#D7E3EF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                <text><![CDATA[MANUFACTURER]]></text>
            </staticText>

            <staticText>
                <reportElement x="305" y="0" width="55" height="38" backcolor="#D9EAF7" forecolor="#000000"/>
                <box><pen lineWidth="0.7" lineColor="#D7E3EF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                <text><![CDATA[SEATS]]></text>
            </staticText>

            <staticText>
                <reportElement x="360" y="0" width="75" height="38" backcolor="#D9EAF7" forecolor="#000000"/>
                <box><pen lineWidth="0.7" lineColor="#D7E3EF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                <text><![CDATA[STATUS]]></text>
            </staticText>

            <staticText>
                <reportElement x="435" y="0" width="62" height="38" backcolor="#D9EAF7" forecolor="#000000"/>
                <box><pen lineWidth="0.7" lineColor="#D7E3EF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                <text><![CDATA[AVAILABLE]]></text>
            </staticText>

            <staticText>
                <reportElement x="497" y="0" width="65" height="38" backcolor="#D9EAF7" forecolor="#000000"/>
                <box><pen lineWidth="0.7" lineColor="#D7E3EF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                <text><![CDATA[AIRPORT ID]]></text>
            </staticText>

            <staticText>
                <reportElement x="562" y="0" width="90" height="38" backcolor="#D9EAF7" forecolor="#000000"/>
                <box><pen lineWidth="0.7" lineColor="#D7E3EF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="6.5" isBold="true"/></textElement>
                <text><![CDATA[MAINTENANCE]]></text>
            </staticText>

            <staticText>
                <reportElement x="652" y="0" width="65" height="38" backcolor="#D9EAF7" forecolor="#000000"/>
                <box><pen lineWidth="0.7" lineColor="#D7E3EF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                <text><![CDATA[TOTAL]]></text>
            </staticText>

            <staticText>
                <reportElement x="717" y="0" width="65" height="38" backcolor="#D9EAF7" forecolor="#000000"/>
                <box><pen lineWidth="0.7" lineColor="#D7E3EF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="6.5" isBold="true"/></textElement>
                <text><![CDATA[OPERATIONAL]]></text>
            </staticText>

        </band>
    </columnHeader>

    <!-- ========================= -->
    <!-- TABLE ROW                 -->
    <!-- ========================= -->
    <detail>
        <band height="30">

            <rectangle>
                <reportElement x="0" y="0" width="782" height="30" backcolor="#F5F8FC"/>
            </rectangle>

            <textField><reportElement x="0" y="0" width="35" height="30"/><box><pen lineWidth="0.5" lineColor="#BCC8D4"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{id}]]></textFieldExpression></textField>
            <textField><reportElement x="35" y="0" width="60" height="30" forecolor="#1D4ED8"/><box><pen lineWidth="0.5" lineColor="#BCC8D4"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{code}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="95" y="0" width="105" height="30"/><box><pen lineWidth="0.5" lineColor="#BCC8D4"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{model}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="200" y="0" width="105" height="30"/><box><pen lineWidth="0.5" lineColor="#BCC8D4"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{manufacturer}]]></textFieldExpression></textField>
            <textField><reportElement x="305" y="0" width="55" height="30" forecolor="#166534"/><box><pen lineWidth="0.5" lineColor="#BCC8D4"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{seatingCapacity} == null ? 0 : $F{seatingCapacity}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="360" y="0" width="75" height="30"/><box><pen lineWidth="0.5" lineColor="#BCC8D4"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="6.5" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{aircraftStatus} == null ? "" : $F{aircraftStatus}.name()]]></textFieldExpression></textField>
            <textField><reportElement x="435" y="0" width="62" height="30"/><box><pen lineWidth="0.5" lineColor="#BCC8D4"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement><textFieldExpression><![CDATA[Boolean.TRUE.equals($F{isAvailable}) ? "YES" : "NO"]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="497" y="0" width="65" height="30"/><box><pen lineWidth="0.5" lineColor="#BCC8D4"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{currentAirportId}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="562" y="0" width="90" height="30"/><box><pen lineWidth="0.5" lineColor="#BCC8D4"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="6.5"/></textElement><textFieldExpression><![CDATA[$F{nextMaintenanceDate}]]></textFieldExpression></textField>
            <textField><reportElement x="652" y="0" width="65" height="30" forecolor="#0F766E"/><box><pen lineWidth="0.5" lineColor="#BCC8D4"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{totalSeats} == null ? 0 : $F{totalSeats}]]></textFieldExpression></textField>
            <textField><reportElement x="717" y="0" width="65" height="30" forecolor="#166534"/><box><pen lineWidth="0.5" lineColor="#BCC8D4"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="6.5" isBold="true"/></textElement><textFieldExpression><![CDATA[Boolean.TRUE.equals($F{operational}) ? "YES" : "NO"]]></textFieldExpression></textField>

        </band>
    </detail>

    <pageFooter>
        <band height="28">
            <line><reportElement x="0" y="0" width="782" height="1" forecolor="#CBD5E1"/></line>

            <textField>
                <reportElement x="0" y="6" width="400" height="16" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Generated Aircraft Management Report"]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="582" y="6" width="200" height="16" forecolor="#64748B"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

</jasperReport>
