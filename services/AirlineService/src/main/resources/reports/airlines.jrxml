<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
        xmlns="http://jasperreports.sourceforge.net/jasperreports"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
        name="airlines"
        pageWidth="842"
        pageHeight="595"
        orientation="Landscape"
        columnWidth="782"
        leftMargin="30"
        rightMargin="30"
        topMargin="25"
        bottomMargin="25">

    <parameter name="REPORT_TITLE" class="java.lang.String"/>

    <field name="id" class="java.lang.Long"/>
    <field name="iataCode" class="java.lang.String"/>
    <field name="icaoCode" class="java.lang.String"/>
    <field name="name" class="java.lang.String"/>
    <field name="country" class="java.lang.String"/>
    <field name="alliance" class="java.lang.String"/>
    <field name="airlineStatus" class="com.airlineportal.utils.Airline.AirlineStatus"/>
    <field name="aircraftCount" class="java.lang.Integer"/>

    <!-- ========================= -->
    <!-- TITLE + BAR CHART         -->
    <!-- ========================= -->
    <title>
        <band height="225">

            <rectangle>
                <reportElement x="0" y="0" width="782" height="62" backcolor="#1E3A5F"/>
            </rectangle>

            <staticText>
                <reportElement x="20" y="8" width="742" height="28" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="20" isBold="true"/>
                </textElement>
                <text><![CDATA[AIRLINE MANAGEMENT REPORT]]></text>
            </staticText>

            <staticText>
                <reportElement x="20" y="40" width="742" height="14" forecolor="#DCE8F5"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <text><![CDATA[Airline profile, status and fleet overview]]></text>
            </staticText>

            <staticText>
                <reportElement x="0" y="69" width="782" height="18" forecolor="#1E3A5F"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[AIRCRAFT COUNT BY AIRLINE]]></text>
            </staticText>

            <barChart>
                <chart evaluationTime="Report" isShowLegend="false">
                    <reportElement x="10" y="90" width="762" height="125"/>
                </chart>

                <categoryDataset>
                    <categorySeries>
                        <seriesExpression><![CDATA["Aircraft"]]></seriesExpression>
                        <categoryExpression><![CDATA[$F{iataCode}]]></categoryExpression>
                        <valueExpression><![CDATA[$F{aircraftCount} == null ? 0 : $F{aircraftCount}]]></valueExpression>
                    </categorySeries>
                </categoryDataset>

                <barPlot
                        isShowLabels="true"
                        isShowTickMarks="true"
                        isShowTickLabels="true">
                    <plot/>
                    <categoryAxisLabelExpression><![CDATA["Airline IATA"]]></categoryAxisLabelExpression>
                    <valueAxisLabelExpression><![CDATA["Aircraft"]]></valueAxisLabelExpression>
                </barPlot>
            </barChart>

        </band>
    </title>

    <!-- ========================= -->
    <!-- TABLE HEADER              -->
    <!-- ========================= -->
    <columnHeader>
        <band height="36">

            <staticText>
                <reportElement x="0" y="0" width="40" height="36" backcolor="#D9EAF7" forecolor="#111827"/>
                <box><pen lineWidth="0.7" lineColor="#D7E3EF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[ID]]></text>
            </staticText>

            <staticText>
                <reportElement x="40" y="0" width="55" height="36" backcolor="#D9EAF7" forecolor="#111827"/>
                <box><pen lineWidth="0.7" lineColor="#D7E3EF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[IATA]]></text>
            </staticText>

            <staticText>
                <reportElement x="95" y="0" width="60" height="36" backcolor="#D9EAF7" forecolor="#111827"/>
                <box><pen lineWidth="0.7" lineColor="#D7E3EF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[ICAO]]></text>
            </staticText>

            <staticText>
                <reportElement x="155" y="0" width="180" height="36" backcolor="#D9EAF7" forecolor="#111827"/>
                <box><pen lineWidth="0.7" lineColor="#D7E3EF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[AIRLINE]]></text>
            </staticText>

            <staticText>
                <reportElement x="335" y="0" width="100" height="36" backcolor="#D9EAF7" forecolor="#111827"/>
                <box><pen lineWidth="0.7" lineColor="#D7E3EF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[COUNTRY]]></text>
            </staticText>

            <staticText>
                <reportElement x="435" y="0" width="100" height="36" backcolor="#D9EAF7" forecolor="#111827"/>
                <box><pen lineWidth="0.7" lineColor="#D7E3EF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[ALLIANCE]]></text>
            </staticText>

            <staticText>
                <reportElement x="535" y="0" width="110" height="36" backcolor="#D9EAF7" forecolor="#111827"/>
                <box><pen lineWidth="0.7" lineColor="#D7E3EF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[STATUS]]></text>
            </staticText>

            <staticText>
                <reportElement x="645" y="0" width="137" height="36" backcolor="#D9EAF7" forecolor="#111827"/>
                <box><pen lineWidth="0.7" lineColor="#D7E3EF"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[AIRCRAFT]]></text>
            </staticText>

        </band>
    </columnHeader>

    <!-- ========================= -->
    <!-- TABLE ROW                 -->
    <!-- ========================= -->
    <detail>
        <band height="30">

            <rectangle>
                <reportElement x="0" y="0" width="782" height="30" backcolor="#F5F8FC"/>
            </rectangle>

            <textField>
                <reportElement x="0" y="0" width="40" height="30"/>
                <box><pen lineWidth="0.5" lineColor="#BCC8D4"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{id}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="40" y="0" width="55" height="30" forecolor="#1D4ED8"/>
                <box><pen lineWidth="0.5" lineColor="#BCC8D4"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{iataCode}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="95" y="0" width="60" height="30"/>
                <box><pen lineWidth="0.5" lineColor="#BCC8D4"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{icaoCode}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="155" y="0" width="180" height="30"/>
                <box><pen lineWidth="0.5" lineColor="#BCC8D4"/></box>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{name}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="335" y="0" width="100" height="30"/>
                <box><pen lineWidth="0.5" lineColor="#BCC8D4"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{country}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="435" y="0" width="100" height="30"/>
                <box><pen lineWidth="0.5" lineColor="#BCC8D4"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{alliance}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="535" y="0" width="110" height="30"/>
                <box><pen lineWidth="0.5" lineColor="#BCC8D4"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{airlineStatus} == null ? "" : $F{airlineStatus}.name()]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="645" y="0" width="137" height="30" forecolor="#166534"/>
                <box><pen lineWidth="0.5" lineColor="#BCC8D4"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{aircraftCount} == null ? 0 : $F{aircraftCount}]]></textFieldExpression>
            </textField>

        </band>
    </detail>

    <pageFooter>
        <band height="28">
            <line>
                <reportElement x="0" y="0" width="782" height="1" forecolor="#CBD5E1"/>
            </line>

            <textField>
                <reportElement x="0" y="6" width="400" height="16" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Generated Airline Management Report"]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="582" y="6" width="200" height="16" forecolor="#64748B"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

</jasperReport>
