<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="flight_instances"
              pageWidth="842"
              pageHeight="595"
              orientation="Landscape"
              columnWidth="782"
              leftMargin="30"
              rightMargin="30"
              topMargin="30"
              bottomMargin="30"
              isIgnorePagination="false">

    <parameter name="REPORT_TITLE" class="java.lang.String"/>

    <field name="id" class="java.lang.Long"/>
    <field name="flightId" class="java.lang.Long"/>
    <field name="flightNumber" class="java.lang.String"/>
    <field name="departureDateTime" class="java.time.LocalDateTime"/>
    <field name="arrivalDateTime" class="java.time.LocalDateTime"/>
    <field name="totalSeats" class="java.lang.Integer"/>
    <field name="availableSeats" class="java.lang.Integer"/>
    <field name="bookedSeats" class="java.lang.Integer"/>
    <field name="flightStatus" class="com.airlineportal.utils.Flight.FlightStatus"/>
    <field name="active" class="java.lang.Boolean"/>
    <field name="formattedDuration" class="java.lang.String"/>
    <field name="soldOut" class="java.lang.Boolean"/>
    <field name="bookingOpen" class="java.lang.Boolean"/>

    <title>
        <band height="78">
            <rectangle><reportElement x="0" y="0" width="782" height="78" backcolor="#1E3A5F"/><graphicElement><pen lineWidth="0.0"/></graphicElement></rectangle>
            <staticText>
                <reportElement x="20" y="10" width="742" height="34" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="24" isBold="true"/></textElement>
                <text><![CDATA[FLIGHT INSTANCE REPORT]]></text>
            </staticText>
            <textField>
                <reportElement x="20" y="47" width="742" height="17" forecolor="#D9EAF7"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{REPORT_TITLE} == null ? "Concrete flight operations, seats and booking availability" : $P{REPORT_TITLE}]]></textFieldExpression>
            </textField>
            <line><reportElement x="285" y="69" width="212" height="1" forecolor="#93C5FD"/></line>
        </band>
    </title>

    <columnHeader>
        <band height="38" splitType="Prevent">
            <staticText><reportElement x="0" y="0" width="42" height="38" mode="Opaque" backcolor="#D9EAF7" forecolor="#000000"/><box><pen lineWidth="0.7" lineColor="#64748B"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[ID]]></text></staticText>
            <staticText><reportElement x="42" y="0" width="78" height="38" mode="Opaque" backcolor="#D9EAF7" forecolor="#000000"/><box><pen lineWidth="0.7" lineColor="#64748B"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[FLIGHT]]></text></staticText>
            <staticText><reportElement x="120" y="0" width="58" height="38" mode="Opaque" backcolor="#D9EAF7" forecolor="#000000"/><box><pen lineWidth="0.7" lineColor="#64748B"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[FLIGHT ID]]></text></staticText>
            <staticText><reportElement x="178" y="0" width="112" height="38" mode="Opaque" backcolor="#D9EAF7" forecolor="#000000"/><box><pen lineWidth="0.7" lineColor="#64748B"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement><text><![CDATA[DEPARTURE]]></text></staticText>
            <staticText><reportElement x="290" y="0" width="112" height="38" mode="Opaque" backcolor="#D9EAF7" forecolor="#000000"/><box><pen lineWidth="0.7" lineColor="#64748B"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement><text><![CDATA[ARRIVAL]]></text></staticText>
            <staticText><reportElement x="402" y="0" width="55" height="38" mode="Opaque" backcolor="#D9EAF7" forecolor="#000000"/><box><pen lineWidth="0.7" lineColor="#64748B"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[TOTAL]]></text></staticText>
            <staticText><reportElement x="457" y="0" width="58" height="38" mode="Opaque" backcolor="#D9EAF7" forecolor="#000000"/><box><pen lineWidth="0.7" lineColor="#64748B"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[AVAILABLE]]></text></staticText>
            <staticText><reportElement x="515" y="0" width="58" height="38" mode="Opaque" backcolor="#D9EAF7" forecolor="#000000"/><box><pen lineWidth="0.7" lineColor="#64748B"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[BOOKED]]></text></staticText>
            <staticText><reportElement x="573" y="0" width="72" height="38" mode="Opaque" backcolor="#D9EAF7" forecolor="#000000"/><box><pen lineWidth="0.7" lineColor="#64748B"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[STATUS]]></text></staticText>
            <staticText><reportElement x="645" y="0" width="50" height="38" mode="Opaque" backcolor="#D9EAF7" forecolor="#000000"/><box><pen lineWidth="0.7" lineColor="#64748B"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[DURATION]]></text></staticText>
            <staticText><reportElement x="695" y="0" width="42" height="38" mode="Opaque" backcolor="#D9EAF7" forecolor="#000000"/><box><pen lineWidth="0.7" lineColor="#64748B"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[SOLD]]></text></staticText>
            <staticText><reportElement x="737" y="0" width="45" height="38" mode="Opaque" backcolor="#D9EAF7" forecolor="#000000"/><box><pen lineWidth="0.7" lineColor="#64748B"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement><text><![CDATA[BOOKING]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="32" splitType="Prevent">
            <rectangle><reportElement x="0" y="0" width="782" height="32" backcolor="#F8FAFC"/><graphicElement><pen lineWidth="0.0"/></graphicElement></rectangle>
            <textField><reportElement x="0" y="0" width="42" height="32"/><box><pen lineWidth="0.7" lineColor="#D1D5DB"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{id}]]></textFieldExpression></textField>
            <textField><reportElement x="42" y="0" width="78" height="32"/><box><pen lineWidth="0.7" lineColor="#D1D5DB"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{flightNumber} == null ? "" : $F{flightNumber}]]></textFieldExpression></textField>
            <textField><reportElement x="120" y="0" width="58" height="32"/><box><pen lineWidth="0.7" lineColor="#D1D5DB"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{flightId}]]></textFieldExpression></textField>
            <textField pattern="dd MMM yyyy HH:mm"><reportElement x="178" y="0" width="112" height="32"/><box><pen lineWidth="0.7" lineColor="#D1D5DB"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{departureDateTime}]]></textFieldExpression></textField>
            <textField pattern="dd MMM yyyy HH:mm"><reportElement x="290" y="0" width="112" height="32"/><box><pen lineWidth="0.7" lineColor="#D1D5DB"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{arrivalDateTime}]]></textFieldExpression></textField>
            <textField><reportElement x="402" y="0" width="55" height="32"/><box><pen lineWidth="0.7" lineColor="#D1D5DB"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{totalSeats}]]></textFieldExpression></textField>
            <textField><reportElement x="457" y="0" width="58" height="32"/><box><pen lineWidth="0.7" lineColor="#D1D5DB"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{availableSeats}]]></textFieldExpression></textField>
            <textField><reportElement x="515" y="0" width="58" height="32"/><box><pen lineWidth="0.7" lineColor="#D1D5DB"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{bookedSeats}]]></textFieldExpression></textField>
            <textField><reportElement x="573" y="0" width="72" height="32"/><box><pen lineWidth="0.7" lineColor="#D1D5DB"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{flightStatus} == null ? "" : $F{flightStatus}.toString()]]></textFieldExpression></textField>
            <textField><reportElement x="645" y="0" width="50" height="32"/><box><pen lineWidth="0.7" lineColor="#D1D5DB"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{formattedDuration} == null ? "" : $F{formattedDuration}]]></textFieldExpression></textField>
            <textField><reportElement x="695" y="0" width="42" height="32"/><box><pen lineWidth="0.7" lineColor="#D1D5DB"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{soldOut} != null && $F{soldOut} ? "YES" : "NO"]]></textFieldExpression></textField>
            <textField><reportElement x="737" y="0" width="45" height="32"/><box><pen lineWidth="0.7" lineColor="#D1D5DB"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{bookingOpen} != null && $F{bookingOpen} ? "OPEN" : "CLOSED"]]></textFieldExpression></textField>
        </band>
    </detail>

    <pageFooter>
        <band height="30">
            <line><reportElement x="0" y="0" width="782" height="1" forecolor="#CBD5E1"/></line>
            <textField><reportElement x="0" y="7" width="420" height="15" forecolor="#64748B"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA["Generated by Flight Service  •  " + new java.text.SimpleDateFormat("dd MMM yyyy, hh:mm a").format(new java.util.Date())]]></textFieldExpression></textField>
            <textField><reportElement x="582" y="7" width="200" height="15" forecolor="#64748B"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression></textField>
        </band>
    </pageFooter>

    <summary>
        <band height="280" splitType="Stretch">
            <barChart>
                <chart evaluationTime="Report" isShowLegend="false">
                    <reportElement x="0" y="0" width="782" height="265" mode="Opaque" backcolor="#FFFFFF"/>
                    <box><pen lineWidth="0.8" lineColor="#CBD5E1"/></box>
                    <chartTitle position="Top" color="#1E3A5F"><font fontName="SansSerif" size="15" isBold="true"/><titleExpression><![CDATA["AVAILABLE SEATS BY FLIGHT INSTANCE"]]></titleExpression></chartTitle>
                    <chartSubtitle color="#64748B"><font fontName="SansSerif" size="8"/><subtitleExpression><![CDATA["Number of currently available seats"]]></subtitleExpression></chartSubtitle>
                </chart>
                <categoryDataset>
                    <categorySeries>
                        <seriesExpression><![CDATA["Available Seats"]]></seriesExpression>
                        <categoryExpression><![CDATA[$F{flightNumber} + " - " + $F{id}]]></categoryExpression>
                        <valueExpression><![CDATA[$F{availableSeats} == null ? 0 : $F{availableSeats}]]></valueExpression>
                        <labelExpression><![CDATA[String.valueOf($F{availableSeats} == null ? 0 : $F{availableSeats})]]></labelExpression>
                    </categorySeries>
                </categoryDataset>
                <barPlot isShowLabels="true" isShowTickMarks="true" isShowTickLabels="true">
                    <plot backcolor="#F8FAFC"/>
                    <categoryAxisLabelExpression><![CDATA["Flight Instance"]]></categoryAxisLabelExpression>
                    <valueAxisLabelExpression><![CDATA["Seats"]]></valueAxisLabelExpression>
                </barPlot>
            </barChart>
        </band>
    </summary>

</jasperReport>
