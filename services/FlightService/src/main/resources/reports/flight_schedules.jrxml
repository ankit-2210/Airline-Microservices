<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="flight_schedules"
              pageWidth="842"
              pageHeight="595"
              orientation="Landscape"
              columnWidth="782"
              leftMargin="30"
              rightMargin="30"
              topMargin="30"
              bottomMargin="30"
              isIgnorePagination="false">

    <parameter name="REPORT_TITLE" class="java.lang.String"/>

    <field name="id" class="java.lang.Long"/>
    <field name="flightId" class="java.lang.Long"/>
    <field name="flightNumber" class="java.lang.String"/>
    <field name="departureTime" class="java.time.LocalTime"/>
    <field name="arrivalTime" class="java.time.LocalTime"/>
    <field name="startDate" class="java.time.LocalDate"/>
    <field name="endDate" class="java.time.LocalDate"/>
    <field name="operatingDays" class="java.lang.String"/>
    <field name="active" class="java.lang.Boolean"/>

    <title>
        <band height="78">
            <rectangle><reportElement x="0" y="0" width="782" height="78" backcolor="#1E3A5F"/><graphicElement><pen lineWidth="0.0"/></graphicElement></rectangle>
            <staticText>
                <reportElement x="20" y="10" width="742" height="34" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="24" isBold="true"/></textElement>
                <text><![CDATA[FLIGHT SCHEDULE REPORT]]></text>
            </staticText>
            <textField>
                <reportElement x="20" y="47" width="742" height="17" forecolor="#D9EAF7"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{REPORT_TITLE} == null ? "Recurring flight timings and operating days" : $P{REPORT_TITLE}]]></textFieldExpression>
            </textField>
            <line><reportElement x="285" y="69" width="212" height="1" forecolor="#93C5FD"/></line>
        </band>
    </title>

    <columnHeader>
        <band height="38" splitType="Prevent">
            <staticText><reportElement x="0" y="0" width="50" height="38" mode="Opaque" backcolor="#D9EAF7" forecolor="#000000"/><box><pen lineWidth="0.7" lineColor="#64748B"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[ID]]></text></staticText>
            <staticText><reportElement x="50" y="0" width="80" height="38" mode="Opaque" backcolor="#D9EAF7" forecolor="#000000"/><box><pen lineWidth="0.7" lineColor="#64748B"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[FLIGHT]]></text></staticText>
            <staticText><reportElement x="130" y="0" width="65" height="38" mode="Opaque" backcolor="#D9EAF7" forecolor="#000000"/><box><pen lineWidth="0.7" lineColor="#64748B"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[FLIGHT ID]]></text></staticText>
            <staticText><reportElement x="195" y="0" width="85" height="38" mode="Opaque" backcolor="#D9EAF7" forecolor="#000000"/><box><pen lineWidth="0.7" lineColor="#64748B"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[DEPARTURE]]></text></staticText>
            <staticText><reportElement x="280" y="0" width="85" height="38" mode="Opaque" backcolor="#D9EAF7" forecolor="#000000"/><box><pen lineWidth="0.7" lineColor="#64748B"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[ARRIVAL]]></text></staticText>
            <staticText><reportElement x="365" y="0" width="95" height="38" mode="Opaque" backcolor="#D9EAF7" forecolor="#000000"/><box><pen lineWidth="0.7" lineColor="#64748B"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[START DATE]]></text></staticText>
            <staticText><reportElement x="460" y="0" width="95" height="38" mode="Opaque" backcolor="#D9EAF7" forecolor="#000000"/><box><pen lineWidth="0.7" lineColor="#64748B"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[END DATE]]></text></staticText>
            <staticText><reportElement x="555" y="0" width="150" height="38" mode="Opaque" backcolor="#D9EAF7" forecolor="#000000"/><box><pen lineWidth="0.7" lineColor="#64748B"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[OPERATING DAYS]]></text></staticText>
            <staticText><reportElement x="705" y="0" width="77" height="38" mode="Opaque" backcolor="#D9EAF7" forecolor="#000000"/><box><pen lineWidth="0.7" lineColor="#64748B"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[ACTIVE]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="32" splitType="Prevent">
            <rectangle><reportElement x="0" y="0" width="782" height="32" backcolor="#F8FAFC"/><graphicElement><pen lineWidth="0.0"/></graphicElement></rectangle>
            <textField><reportElement x="0" y="0" width="50" height="32"/><box><pen lineWidth="0.7" lineColor="#D1D5DB"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{id}]]></textFieldExpression></textField>
            <textField><reportElement x="50" y="0" width="80" height="32"/><box><pen lineWidth="0.7" lineColor="#D1D5DB"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{flightNumber} == null ? "" : $F{flightNumber}]]></textFieldExpression></textField>
            <textField><reportElement x="130" y="0" width="65" height="32"/><box><pen lineWidth="0.7" lineColor="#D1D5DB"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{flightId}]]></textFieldExpression></textField>
            <textField pattern="HH:mm"><reportElement x="195" y="0" width="85" height="32"/><box><pen lineWidth="0.7" lineColor="#D1D5DB"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{departureTime}]]></textFieldExpression></textField>
            <textField pattern="HH:mm"><reportElement x="280" y="0" width="85" height="32"/><box><pen lineWidth="0.7" lineColor="#D1D5DB"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{arrivalTime}]]></textFieldExpression></textField>
            <textField pattern="dd MMM yyyy"><reportElement x="365" y="0" width="95" height="32"/><box><pen lineWidth="0.7" lineColor="#D1D5DB"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{startDate}]]></textFieldExpression></textField>
            <textField pattern="dd MMM yyyy"><reportElement x="460" y="0" width="95" height="32"/><box><pen lineWidth="0.7" lineColor="#D1D5DB"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{endDate}]]></textFieldExpression></textField>
            <textField><reportElement x="555" y="0" width="150" height="32"/><box><pen lineWidth="0.7" lineColor="#D1D5DB"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{operatingDays} == null ? "" : $F{operatingDays}]]></textFieldExpression></textField>
            <textField><reportElement x="705" y="0" width="77" height="32"/><box><pen lineWidth="0.7" lineColor="#D1D5DB"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{active} != null && $F{active} ? "YES" : "NO"]]></textFieldExpression></textField>
        </band>
    </detail>

    <pageFooter>
        <band height="30">
            <line><reportElement x="0" y="0" width="782" height="1" forecolor="#CBD5E1"/></line>
            <textField><reportElement x="0" y="7" width="420" height="15" forecolor="#64748B"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA["Generated by Flight Service  •  " + new java.text.SimpleDateFormat("dd MMM yyyy, hh:mm a").format(new java.util.Date())]]></textFieldExpression></textField>
            <textField><reportElement x="582" y="7" width="200" height="15" forecolor="#64748B"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression></textField>
        </band>
    </pageFooter>

    <summary>
        <band height="280" splitType="Stretch">
            <barChart>
                <chart evaluationTime="Report" isShowLegend="false">
                    <reportElement x="0" y="0" width="782" height="265" mode="Opaque" backcolor="#FFFFFF"/>
                    <box><pen lineWidth="0.8" lineColor="#CBD5E1"/></box>
                    <chartTitle position="Top" color="#1E3A5F"><font fontName="SansSerif" size="15" isBold="true"/><titleExpression><![CDATA["SCHEDULE TIME BY FLIGHT"]]></titleExpression></chartTitle>
                    <chartSubtitle color="#64748B"><font fontName="SansSerif" size="8"/><subtitleExpression><![CDATA["Departure-to-arrival schedule duration in minutes"]]></subtitleExpression></chartSubtitle>
                </chart>
                <categoryDataset>
                    <categorySeries>
                        <seriesExpression><![CDATA["Schedule Duration"]]></seriesExpression>
                        <categoryExpression><![CDATA[$F{flightNumber}]]></categoryExpression>
                        <valueExpression><![CDATA[(($F{departureTime} == null || $F{arrivalTime} == null) ? 0 : java.time.Duration.between($F{departureTime}, $F{arrivalTime}).toMinutes())]]></valueExpression>
                        <labelExpression><![CDATA[String.valueOf((($F{departureTime} == null || $F{arrivalTime} == null) ? 0 : java.time.Duration.between($F{departureTime}, $F{arrivalTime}).toMinutes()))]]></labelExpression>
                    </categorySeries>
                </categoryDataset>
                <barPlot isShowLabels="true" isShowTickMarks="true" isShowTickLabels="true">
                    <plot backcolor="#F8FAFC"/>
                    <categoryAxisLabelExpression><![CDATA["Flight Number"]]></categoryAxisLabelExpression>
                    <valueAxisLabelExpression><![CDATA["Minutes"]]></valueAxisLabelExpression>
                </barPlot>
            </barChart>
        </band>
    </summary>

</jasperReport>
