<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="flights"
              pageWidth="842"
              pageHeight="595"
              orientation="Landscape"
              columnWidth="782"
              leftMargin="30"
              rightMargin="30"
              topMargin="30"
              bottomMargin="30"
              isIgnorePagination="false">

    <parameter name="REPORT_TITLE" class="java.lang.String"/>

    <field name="id" class="java.lang.Long"/>
    <field name="flightNumber" class="java.lang.String"/>
    <field name="airlineId" class="java.lang.Long"/>
    <field name="aircraftId" class="java.lang.Long"/>
    <field name="departureAirportId" class="java.lang.Long"/>
    <field name="arrivalAirportId" class="java.lang.Long"/>
    <field name="scheduledDeparture" class="java.time.LocalDateTime"/>
    <field name="scheduledArrival" class="java.time.LocalDateTime"/>
    <field name="actualDeparture" class="java.time.LocalDateTime"/>
    <field name="actualArrival" class="java.time.LocalDateTime"/>
    <field name="flightStatus" class="com.airlineportal.utils.Flight.FlightStatus"/>
    <field name="active" class="java.lang.Boolean"/>
    <field name="delayed" class="java.lang.Boolean"/>
    <field name="delayMinutes" class="java.lang.Long"/>
    <field name="scheduledDurationMinutes" class="java.lang.Long"/>
    <field name="operational" class="java.lang.Boolean"/>

    <title>
        <band height="78">
            <rectangle>
                <reportElement x="0" y="0" width="782" height="78" backcolor="#1E3A5F"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="20" y="10" width="742" height="34" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="24" isBold="true"/>
                </textElement>
                <text><![CDATA[FLIGHT MANAGEMENT REPORT]]></text>
            </staticText>
            <textField>
                <reportElement x="20" y="47" width="742" height="17" forecolor="#D9EAF7"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{REPORT_TITLE} == null ? "Flight routes, schedules and operational status" : $P{REPORT_TITLE}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="285" y="69" width="212" height="1" forecolor="#93C5FD"/>
            </line>
        </band>
    </title>

    <columnHeader>
        <band height="38" splitType="Prevent">
            <staticText>
                <reportElement x="0" y="0" width="42" height="38" mode="Opaque" backcolor="#D9EAF7" forecolor="#000000"/>
                <box><pen lineWidth="0.7" lineColor="#64748B"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[ID]]></text>
            </staticText>
            <staticText>
                <reportElement x="42" y="0" width="82" height="38" mode="Opaque" backcolor="#D9EAF7" forecolor="#000000"/>
                <box><pen lineWidth="0.7" lineColor="#64748B"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[FLIGHT NO.]]></text>
            </staticText>
            <staticText>
                <reportElement x="124" y="0" width="55" height="38" mode="Opaque" backcolor="#D9EAF7" forecolor="#000000"/>
                <box><pen lineWidth="0.7" lineColor="#64748B"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[AIRLINE]]></text>
            </staticText>
            <staticText>
                <reportElement x="179" y="0" width="55" height="38" mode="Opaque" backcolor="#D9EAF7" forecolor="#000000"/>
                <box><pen lineWidth="0.7" lineColor="#64748B"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[AIRCRAFT]]></text>
            </staticText>
            <staticText>
                <reportElement x="234" y="0" width="65" height="38" mode="Opaque" backcolor="#D9EAF7" forecolor="#000000"/>
                <box><pen lineWidth="0.7" lineColor="#64748B"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[DEPARTURE]]></text>
            </staticText>
            <staticText>
                <reportElement x="299" y="0" width="65" height="38" mode="Opaque" backcolor="#D9EAF7" forecolor="#000000"/>
                <box><pen lineWidth="0.7" lineColor="#64748B"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[ARRIVAL]]></text>
            </staticText>
            <staticText>
                <reportElement x="364" y="0" width="105" height="38" mode="Opaque" backcolor="#D9EAF7" forecolor="#000000"/>
                <box><pen lineWidth="0.7" lineColor="#64748B"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="7" isBold="true"/></textElement>
                <text><![CDATA[SCHEDULED DEPARTURE]]></text>
            </staticText>
            <staticText>
                <reportElement x="469" y="0" width="105" height="38" mode="Opaque" backcolor="#D9EAF7" forecolor="#000000"/>
                <box><pen lineWidth="0.7" lineColor="#64748B"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="7" isBold="true"/></textElement>
                <text><![CDATA[SCHEDULED ARRIVAL]]></text>
            </staticText>
            <staticText>
                <reportElement x="574" y="0" width="72" height="38" mode="Opaque" backcolor="#D9EAF7" forecolor="#000000"/>
                <box><pen lineWidth="0.7" lineColor="#64748B"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[STATUS]]></text>
            </staticText>
            <staticText>
                <reportElement x="646" y="0" width="50" height="38" mode="Opaque" backcolor="#D9EAF7" forecolor="#000000"/>
                <box><pen lineWidth="0.7" lineColor="#64748B"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[DELAY]]></text>
            </staticText>
            <staticText>
                <reportElement x="696" y="0" width="86" height="38" mode="Opaque" backcolor="#D9EAF7" forecolor="#000000"/>
                <box><pen lineWidth="0.7" lineColor="#64748B"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[DURATION / ACTIVE]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="32" splitType="Prevent">
            <rectangle>
                <reportElement x="0" y="0" width="782" height="32" backcolor="#F8FAFC"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <textField><reportElement x="0" y="0" width="42" height="32" forecolor="#111827"/><box><pen lineWidth="0.7" lineColor="#D1D5DB"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{id}]]></textFieldExpression></textField>
            <textField><reportElement x="42" y="0" width="82" height="32" forecolor="#111827"/><box><pen lineWidth="0.7" lineColor="#D1D5DB"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{flightNumber} == null ? "" : $F{flightNumber}]]></textFieldExpression></textField>
            <textField><reportElement x="124" y="0" width="55" height="32" forecolor="#111827"/><box><pen lineWidth="0.7" lineColor="#D1D5DB"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{airlineId}]]></textFieldExpression></textField>
            <textField><reportElement x="179" y="0" width="55" height="32" forecolor="#111827"/><box><pen lineWidth="0.7" lineColor="#D1D5DB"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{aircraftId}]]></textFieldExpression></textField>
            <textField><reportElement x="234" y="0" width="65" height="32" forecolor="#111827"/><box><pen lineWidth="0.7" lineColor="#D1D5DB"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{departureAirportId}]]></textFieldExpression></textField>
            <textField><reportElement x="299" y="0" width="65" height="32" forecolor="#111827"/><box><pen lineWidth="0.7" lineColor="#D1D5DB"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{arrivalAirportId}]]></textFieldExpression></textField>
            <textField pattern="dd MMM yyyy HH:mm"><reportElement x="364" y="0" width="105" height="32" forecolor="#111827"/><box><pen lineWidth="0.7" lineColor="#D1D5DB"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{scheduledDeparture}]]></textFieldExpression></textField>
            <textField pattern="dd MMM yyyy HH:mm"><reportElement x="469" y="0" width="105" height="32" forecolor="#111827"/><box><pen lineWidth="0.7" lineColor="#D1D5DB"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{scheduledArrival}]]></textFieldExpression></textField>
            <textField><reportElement x="574" y="0" width="72" height="32" forecolor="#111827"/><box><pen lineWidth="0.7" lineColor="#D1D5DB"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{flightStatus} == null ? "" : $F{flightStatus}.toString()]]></textFieldExpression></textField>
            <textField><reportElement x="646" y="0" width="50" height="32" forecolor="#111827"/><box><pen lineWidth="0.7" lineColor="#D1D5DB"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{delayed} == null ? "-" : ($F{delayed} ? String.valueOf($F{delayMinutes}) + " min" : "No")]]></textFieldExpression></textField>
            <textField><reportElement x="696" y="0" width="86" height="32" forecolor="#111827"/><box><pen lineWidth="0.7" lineColor="#D1D5DB"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[($F{scheduledDurationMinutes} == null ? 0 : $F{scheduledDurationMinutes}) + " min / " + ($F{active} != null && $F{active} ? "YES" : "NO")]]></textFieldExpression></textField>
        </band>
    </detail>

    <pageFooter>
        <band height="30">
            <line><reportElement x="0" y="0" width="782" height="1" forecolor="#CBD5E1"/></line>
            <textField><reportElement x="0" y="7" width="420" height="15" forecolor="#64748B"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA["Generated by Flight Service  •  " + new java.text.SimpleDateFormat("dd MMM yyyy, hh:mm a").format(new java.util.Date())]]></textFieldExpression></textField>
            <textField><reportElement x="582" y="7" width="200" height="15" forecolor="#64748B"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement><textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression></textField>
        </band>
    </pageFooter>

    <summary>
        <band height="280" splitType="Stretch">
            <barChart>
                <chart evaluationTime="Report" isShowLegend="false">
                    <reportElement x="0" y="0" width="782" height="265" mode="Opaque" backcolor="#FFFFFF"/>
                    <box><pen lineWidth="0.8" lineColor="#CBD5E1"/></box>
                    <chartTitle position="Top" color="#1E3A5F"><font fontName="SansSerif" size="15" isBold="true"/><titleExpression><![CDATA["SCHEDULED DURATION BY FLIGHT"]]></titleExpression></chartTitle>
                    <chartSubtitle color="#64748B"><font fontName="SansSerif" size="8"/><subtitleExpression><![CDATA["Scheduled duration in minutes"]]></subtitleExpression></chartSubtitle>
                </chart>
                <categoryDataset>
                    <categorySeries>
                        <seriesExpression><![CDATA["Duration (Minutes)"]]></seriesExpression>
                        <categoryExpression><![CDATA[$F{flightNumber}]]></categoryExpression>
                        <valueExpression><![CDATA[$F{scheduledDurationMinutes} == null ? 0 : $F{scheduledDurationMinutes}]]></valueExpression>
                        <labelExpression><![CDATA[String.valueOf($F{scheduledDurationMinutes} == null ? 0 : $F{scheduledDurationMinutes})]]></labelExpression>
                    </categorySeries>
                </categoryDataset>
                <barPlot isShowLabels="true" isShowTickMarks="true" isShowTickLabels="true">
                    <plot backcolor="#F8FAFC"/>
                    <categoryAxisLabelExpression><![CDATA["Flight Number"]]></categoryAxisLabelExpression>
                    <valueAxisLabelExpression><![CDATA["Minutes"]]></valueAxisLabelExpression>
                </barPlot>
            </barChart>
        </band>
    </summary>

</jasperReport>
