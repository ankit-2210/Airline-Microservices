<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
        xmlns="http://jasperreports.sourceforge.net/jasperreports"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://jasperreports.sourceforge.net/jasperreports
        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
        name="airports"
        pageWidth="842"
        pageHeight="595"
        orientation="Landscape"
        columnWidth="782"
        leftMargin="30"
        rightMargin="30"
        topMargin="30"
        bottomMargin="30"
        uuid="11111111-1111-1111-1111-111111111111">

    <property name="com.jaspersoft.studio.data.defaultdataadapter"
              value="One Empty Record"/>

    <!-- ========================= -->
    <!-- Fields                    -->
    <!-- ========================= -->

    <field name="id" class="java.lang.Long"/>
    <field name="iataCode" class="java.lang.String"/>
    <field name="name" class="java.lang.String"/>
    <field name="cityName" class="java.lang.String"/>
    <field name="cityCode" class="java.lang.String"/>
    <field name="countryCode" class="java.lang.String"/>
    <field name="countryName" class="java.lang.String"/>
    <field name="timeZoneId" class="java.lang.String"/>
    <field name="latitude" class="java.lang.Double"/>
    <field name="longitude" class="java.lang.Double"/>

    <!-- ========================= -->
    <!-- Title                     -->
    <!-- ========================= -->

    <title>
        <band height="65">
            <rectangle>
                <reportElement
                        x="0"
                        y="0"
                        width="782"
                        height="65"
                        backcolor="#1E3A5F"
                        uuid="11111111-1111-1111-1111-111111111112"/>
            </rectangle>

            <staticText>
                <reportElement
                        x="20"
                        y="10"
                        width="742"
                        height="30"
                        forecolor="#FFFFFF"
                        uuid="11111111-1111-1111-1111-111111111113"/>

                <textElement textAlignment="Center" verticalAlignment="Middle">
                <font
                        fontName="SansSerif"
                        size="22"
                        isBold="true"/>
                </textElement>

                <text><![CDATA[AIRPORT DIRECTORY]]></text>

            </staticText>

            <staticText>
                <reportElement
                        x="20"
                        y="42"
                        width="742"
                        height="15"
                        forecolor="#D9E8F5"
                        uuid="11111111-1111-1111-1111-111111111114"/>

                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font
                        fontName="SansSerif"
                        size="9"/>
                </textElement>

                <text><![CDATA[Airport and location information]]></text>

            </staticText>

        </band>
    </title>

    <!-- ========================= -->
    <!-- Column Header             -->
    <!-- ========================= -->
    <columnHeader>
        <band height="32">

            <!-- ID -->
            <staticText>
                <reportElement
                        x="0"
                        y="0"
                        width="45"
                        height="32"
                        backcolor="#3B82F6"
                        forecolor="#FFFFFF"
                        uuid="11111111-1111-1111-1111-111111111115"/>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">
                <font
                        fontName="SansSerif"
                        size="9"
                        isBold="true"/>
                </textElement>

                <text><![CDATA[ID]]></text>
            </staticText>

            <!-- IATA -->
            <staticText>
                <reportElement
                        x="45"
                        y="0"
                        width="60"
                        height="32"
                        backcolor="#3B82F6"
                        forecolor="#FFFFFF"
                        uuid="11111111-1111-1111-1111-111111111116"/>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">
                <font
                        fontName="SansSerif"
                        size="9"
                        isBold="true"/>
                </textElement>

                <text><![CDATA[IATA]]></text>
            </staticText>

            <!-- Airport -->
            <staticText>
                <reportElement
                        x="105"
                        y="0"
                        width="145"
                        height="32"
                        backcolor="#3B82F6"
                        forecolor="#FFFFFF"
                        uuid="11111111-1111-1111-1111-111111111117"/>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">
                <font
                        fontName="SansSerif"
                        size="9"
                        isBold="true"/>
                </textElement>

                <text><![CDATA[AIRPORT]]></text>
            </staticText>

            <!-- City -->
            <staticText>
                <reportElement
                        x="250"
                        y="0"
                        width="95"
                        height="32"
                        backcolor="#3B82F6"
                        forecolor="#FFFFFF"
                        uuid="11111111-1111-1111-1111-111111111118"/>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">
                <font
                        fontName="SansSerif"
                        size="9"
                        isBold="true"/>
                </textElement>

                <text><![CDATA[CITY]]></text>
            </staticText>

            <!-- Country -->
            <staticText>
                <reportElement
                        x="345"
                        y="0"
                        width="65"
                        height="32"
                        backcolor="#3B82F6"
                        forecolor="#FFFFFF"
                        uuid="11111111-1111-1111-1111-111111111119"/>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">
                <font
                        fontName="SansSerif"
                        size="9"
                        isBold="true"/>

                </textElement>

                <text><![CDATA[COUNTRY]]></text>
            </staticText>

            <!-- Country Name -->
            <staticText>
                <reportElement
                        x="410"
                        y="0"
                        width="105"
                        height="32"
                        backcolor="#3B82F6"
                        forecolor="#FFFFFF"
                        uuid="11111111-1111-1111-1111-111111111120"/>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">
                <font
                        fontName="SansSerif"
                        size="9"
                        isBold="true"/>
                </textElement>

                <text><![CDATA[COUNTRY NAME]]></text>
            </staticText>

            <!-- Timezone -->
            <staticText>
                <reportElement
                        x="515"
                        y="0"
                        width="105"
                        height="32"
                        backcolor="#3B82F6"
                        forecolor="#FFFFFF"
                        uuid="11111111-1111-1111-1111-111111111121"/>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                <font
                        fontName="SansSerif"
                        size="9"
                        isBold="true"/>
                </textElement>

                <text><![CDATA[TIME ZONE]]></text>
            </staticText>

            <!-- Latitude -->
            <staticText>
                <reportElement
                        x="620"
                        y="0"
                        width="81"
                        height="32"
                        backcolor="#3B82F6"
                        forecolor="#FFFFFF"
                        uuid="11111111-1111-1111-1111-111111111122"/>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                <font
                        fontName="SansSerif"
                        size="9"
                        isBold="true"/>
                </textElement>

                <text><![CDATA[LATITUDE]]></text>
            </staticText>

            <!-- Longitude -->
            <staticText>
                <reportElement
                        x="701"
                        y="0"
                        width="81"
                        height="32"
                        backcolor="#3B82F6"
                        forecolor="#FFFFFF"
                        uuid="11111111-1111-1111-1111-111111111123"/>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                <font
                        fontName="SansSerif"
                        size="9"
                        isBold="true"/>
                </textElement>

                <text><![CDATA[LONGITUDE]]></text>
            </staticText>

        </band>
    </columnHeader>

    <!-- ========================= -->
    <!-- Detail                    -->
    <!-- ========================= -->

    <detail>
        <band height="30">

            <!-- Row background -->
            <rectangle>
                <reportElement
                        x="0"
                        y="0"
                        width="782"
                        height="30"
                        backcolor="#F4F8FC"
                        uuid="11111111-1111-1111-1111-111111111124"/>
            </rectangle>

            <!-- ID -->
            <textField>
                <reportElement
                        x="0"
                        y="0"
                        width="45"
                        height="30"
                        forecolor="#1F2937"
                        uuid="11111111-1111-1111-1111-111111111125"/>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                <font
                        fontName="SansSerif"
                        size="8"/>
                </textElement>

                <textFieldExpression><![CDATA[$F{id}]]></textFieldExpression>
            </textField>

            <!-- IATA -->
            <textField>
                <reportElement
                        x="45"
                        y="0"
                        width="60"
                        height="30"
                        forecolor="#1D4ED8"
                        uuid="11111111-1111-1111-1111-111111111126"/>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">
                <font
                        fontName="SansSerif"
                        size="9"
                        isBold="true"/>
                </textElement>

                <textFieldExpression><![CDATA[$F{iataCode}]]></textFieldExpression>
            </textField>

            <!-- Airport -->
            <textField>
                <reportElement
                        x="105"
                        y="0"
                        width="145"
                        height="30"
                        forecolor="#111827"
                        uuid="11111111-1111-1111-1111-111111111127"/>

                <textElement
                        textAlignment="Left"
                        verticalAlignment="Middle">
                <font
                        fontName="SansSerif"
                        size="8"/>
                </textElement>

                <textFieldExpression><![CDATA[$F{name}]]></textFieldExpression>
            </textField>

            <!-- City -->
            <textField>
                <reportElement
                        x="250"
                        y="0"
                        width="95"
                        height="30"
                        forecolor="#111827"
                        uuid="11111111-1111-1111-1111-111111111128"/>

                <textElement
                        textAlignment="Left"
                        verticalAlignment="Middle">
                <font
                        fontName="SansSerif"
                        size="8"/>
                </textElement>

                <textFieldExpression><![CDATA[
                    $F{cityName} == null ? "" : $F{cityName}
                ]]></textFieldExpression>
            </textField>

            <!-- Country Code -->
            <textField>
                <reportElement
                        x="345"
                        y="0"
                        width="65"
                        height="30"
                        forecolor="#111827"
                        uuid="11111111-1111-1111-1111-111111111129"/>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">
                <font
                        fontName="SansSerif"
                        size="8"
                        isBold="true"/>
                </textElement>

                <textFieldExpression><![CDATA[
                    $F{countryCode} == null ? "" : $F{countryCode}
                ]]></textFieldExpression>
            </textField>

            <!-- Country Name -->
            <textField>
                <reportElement
                        x="410"
                        y="0"
                        width="105"
                        height="30"
                        forecolor="#111827"
                        uuid="11111111-1111-1111-1111-111111111130"/>

                <textElement
                        textAlignment="Left"
                        verticalAlignment="Middle">
                <font
                        fontName="SansSerif"
                        size="8"/>
                </textElement>

                <textFieldExpression><![CDATA[
                    $F{countryName} == null ? "" : $F{countryName}
                ]]></textFieldExpression>
            </textField>

            <!-- Timezone -->
            <textField>
                <reportElement
                        x="515"
                        y="0"
                        width="105"
                        height="30"
                        forecolor="#111827"
                        uuid="11111111-1111-1111-1111-111111111131"/>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">
                <font
                        fontName="SansSerif"
                        size="7"/>
                </textElement>

                <textFieldExpression><![CDATA[
                    $F{timeZoneId} == null ? "" : $F{timeZoneId}
                ]]></textFieldExpression>
            </textField>

            <!-- Latitude -->
            <textField pattern="0.000000">
                <reportElement
                        x="620"
                        y="0"
                        width="81"
                        height="30"
                        forecolor="#111827"
                        uuid="11111111-1111-1111-1111-111111111132"/>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">
                <font
                        fontName="SansSerif"
                        size="7"/>
                </textElement>

                <textFieldExpression><![CDATA[$F{latitude}]]></textFieldExpression>
            </textField>

            <!-- Longitude -->
            <textField pattern="0.000000">
                <reportElement
                        x="701"
                        y="0"
                        width="81"
                        height="30"
                        forecolor="#111827"
                        uuid="11111111-1111-1111-1111-111111111133"/>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">
                <font
                        fontName="SansSerif"
                        size="7"/>
                </textElement>

                <textFieldExpression><![CDATA[$F{longitude}]]></textFieldExpression>
            </textField>

            <!-- Bottom border -->
            <line>
                <reportElement
                        x="0"
                        y="29"
                        width="782"
                        height="1"
                        forecolor="#D1D5DB"
                        uuid="11111111-1111-1111-1111-111111111134"/>
            </line>

        </band>
    </detail>

    <!-- ========================= -->
    <!-- Footer                    -->
    <!-- ========================= -->

    <pageFooter>
        <band height="25">

            <line>
                <reportElement
                        x="0"
                        y="0"
                        width="782"
                        height="1"
                        forecolor="#CBD5E1"
                        uuid="11111111-1111-1111-1111-111111111135"/>
            </line>

            <textField>
                <reportElement
                        x="0"
                        y="5"
                        width="400"
                        height="15"
                        forecolor="#64748B"
                        uuid="11111111-1111-1111-1111-111111111136"/>

                <textElement
                        textAlignment="Left"
                        verticalAlignment="Middle">
                <font
                        fontName="SansSerif"
                        size="8"/>
                </textElement>

                <textFieldExpression><![CDATA[
                    "Generated Airport Directory"
                ]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement
                        x="582"
                        y="5"
                        width="200"
                        height="15"
                        forecolor="#64748B"
                        uuid="11111111-1111-1111-1111-111111111137"/>

                <textElement
                        textAlignment="Right"
                        verticalAlignment="Middle">
                <font
                        fontName="SansSerif"
                        size="8"/>
                </textElement>

                <textFieldExpression><![CDATA[
                    "Page " + $V{PAGE_NUMBER}
                ]]></textFieldExpression>
            </textField>

        </band>
    </pageFooter>

</jasperReport>