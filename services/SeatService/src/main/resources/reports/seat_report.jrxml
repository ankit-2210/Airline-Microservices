<?xml version="1.0" encoding="UTF-8"?>

<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                                  http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="seat_report"
              pageWidth="842"
              pageHeight="595"
              orientation="Landscape"
              columnWidth="782"
              leftMargin="30"
              rightMargin="30"
              topMargin="25"
              bottomMargin="25"
              uuid="9f6a5d31-6a1d-4d0f-8b9f-2c5e7a41d632">

    <!-- ========================= -->
    <!-- FIELDS -->
    <!-- ========================= -->

    <field name="id" class="java.lang.Long"/>

    <field name="flightInstanceId"
           class="java.lang.Long"/>

    <field name="seatNumber"
           class="java.lang.String"/>

    <field name="seatClass"
           class="java.lang.String"/>

    <field name="seatStatus"
           class="java.lang.String"/>

    <field name="bookingId"
           class="java.lang.Long"/>

    <field name="createdAt"
           class="java.lang.String"/>

    <field name="updatedAt"
           class="java.lang.String"/>


    <!-- ========================= -->
    <!-- TITLE -->
    <!-- ========================= -->

    <title>

        <band height="70">

            <rectangle>

                <reportElement
                        x="0"
                        y="0"
                        width="782"
                        height="65"
                        backcolor="#1F4E78"/>

            </rectangle>

            <staticText>

                <reportElement
                        x="20"
                        y="10"
                        width="742"
                        height="28"
                        forecolor="#FFFFFF"/>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                    <font
                            size="20"
                            isBold="true"/>

                </textElement>

                <text><![CDATA[SEAT REPORT]]></text>

            </staticText>


            <staticText>

                <reportElement
                        x="20"
                        y="40"
                        width="742"
                        height="18"
                        forecolor="#FFFFFF"/>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                    <font size="10"/>

                </textElement>

                <text><![CDATA[Airline Portal - Seat Inventory Summary]]></text>

            </staticText>

        </band>

    </title>


    <!-- ========================= -->
    <!-- COLUMN HEADER -->
    <!-- ========================= -->

    <columnHeader>

        <band height="35">

            <rectangle>

                <reportElement
                        x="0"
                        y="0"
                        width="782"
                        height="32"
                        backcolor="#D9EAF7"/>

            </rectangle>


            <!-- ID -->

            <staticText>

                <reportElement
                        x="0"
                        y="0"
                        width="55"
                        height="32"/>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                    <font
                            size="9"
                            isBold="true"/>

                </textElement>

                <text><![CDATA[ID]]></text>

            </staticText>


            <!-- FLIGHT INSTANCE -->

            <staticText>

                <reportElement
                        x="55"
                        y="0"
                        width="105"
                        height="32"/>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                    <font
                            size="9"
                            isBold="true"/>

                </textElement>

                <text><![CDATA[Flight Instance]]></text>

            </staticText>


            <!-- SEAT -->

            <staticText>

                <reportElement
                        x="160"
                        y="0"
                        width="80"
                        height="32"/>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                    <font
                            size="9"
                            isBold="true"/>

                </textElement>

                <text><![CDATA[Seat]]></text>

            </staticText>


            <!-- CLASS -->

            <staticText>

                <reportElement
                        x="240"
                        y="0"
                        width="135"
                        height="32"/>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                    <font
                            size="9"
                            isBold="true"/>

                </textElement>

                <text><![CDATA[Seat Class]]></text>

            </staticText>


            <!-- STATUS -->

            <staticText>

                <reportElement
                        x="375"
                        y="0"
                        width="120"
                        height="32"/>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                    <font
                            size="9"
                            isBold="true"/>

                </textElement>

                <text><![CDATA[Status]]></text>

            </staticText>


            <!-- BOOKING -->

            <staticText>

                <reportElement
                        x="495"
                        y="0"
                        width="90"
                        height="32"/>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                    <font
                            size="9"
                            isBold="true"/>

                </textElement>

                <text><![CDATA[Booking ID]]></text>

            </staticText>


            <!-- CREATED -->

            <staticText>

                <reportElement
                        x="585"
                        y="0"
                        width="98"
                        height="32"/>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                    <font
                            size="9"
                            isBold="true"/>

                </textElement>

                <text><![CDATA[Created At]]></text>

            </staticText>


            <!-- UPDATED -->

            <staticText>

                <reportElement
                        x="683"
                        y="0"
                        width="99"
                        height="32"/>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                    <font
                            size="9"
                            isBold="true"/>

                </textElement>

                <text><![CDATA[Updated At]]></text>

            </staticText>

        </band>

    </columnHeader>


    <!-- ========================= -->
    <!-- DETAIL -->
    <!-- ========================= -->

    <detail>

        <band height="32">


            <!-- ID -->

            <textField>

                <reportElement
                        x="0"
                        y="0"
                        width="55"
                        height="30"/>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                    <font size="8"/>

                </textElement>

                <textFieldExpression>
                    <![CDATA[$F{id}]]>
                </textFieldExpression>

            </textField>


            <!-- FLIGHT INSTANCE -->

            <textField>

                <reportElement
                        x="55"
                        y="0"
                        width="105"
                        height="30"/>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                    <font size="8"/>

                </textElement>

                <textFieldExpression>
                    <![CDATA[$F{flightInstanceId}]]>
                </textFieldExpression>

            </textField>


            <!-- SEAT -->

            <textField>

                <reportElement
                        x="160"
                        y="0"
                        width="80"
                        height="30"/>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                    <font
                            size="9"
                            isBold="true"/>

                </textElement>

                <textFieldExpression>
                    <![CDATA[$F{seatNumber}]]>
                </textFieldExpression>

            </textField>


            <!-- CLASS -->

            <textField>

                <reportElement
                        x="240"
                        y="0"
                        width="135"
                        height="30"/>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                    <font size="8"/>

                </textElement>

                <textFieldExpression>
                    <![CDATA[$F{seatClass}]]>
                </textFieldExpression>

            </textField>


            <!-- STATUS -->

            <textField>

                <reportElement
                        x="375"
                        y="0"
                        width="120"
                        height="30"/>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                    <font
                            size="8"
                            isBold="true"/>

                </textElement>

                <textFieldExpression>
                    <![CDATA[$F{seatStatus}]]>
                </textFieldExpression>

            </textField>


            <!-- BOOKING -->

            <textField>

                <reportElement
                        x="495"
                        y="0"
                        width="90"
                        height="30"/>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                    <font size="8"/>

                </textElement>

                <textFieldExpression>
                    <![CDATA[
                        $F{bookingId} == null
                        ? "-"
                        : $F{bookingId}.toString()
                    ]]>
                </textFieldExpression>

            </textField>


            <!-- CREATED -->

            <textField>

                <reportElement
                        x="585"
                        y="0"
                        width="98"
                        height="30"/>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                    <font size="7"/>

                </textElement>

                <textFieldExpression>
                    <![CDATA[
                        $F{createdAt} == null
                        ? "-"
                        : $F{createdAt}.toString()
                    ]]>
                </textFieldExpression>

            </textField>


            <!-- UPDATED -->

            <textField>

                <reportElement
                        x="683"
                        y="0"
                        width="99"
                        height="30"/>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                    <font size="7"/>

                </textElement>

                <textFieldExpression>
                    <![CDATA[
                        $F{updatedAt} == null
                        ? "-"
                        : $F{updatedAt}.toString()
                    ]]>
                </textFieldExpression>

            </textField>


            <!-- ROW LINE -->

            <line>

                <reportElement
                        x="0"
                        y="31"
                        width="782"
                        height="1"/>

            </line>

        </band>

    </detail>


    <!-- ========================= -->
    <!-- PAGE FOOTER -->
    <!-- ========================= -->

    <pageFooter>

        <band height="30">

            <line>

                <reportElement
                        x="0"
                        y="2"
                        width="782"
                        height="1"/>

            </line>


            <staticText>

                <reportElement
                        x="0"
                        y="8"
                        width="500"
                        height="18"/>

                <textElement
                        verticalAlignment="Middle">

                    <font size="8"/>

                </textElement>

                <text><![CDATA[Airline Portal - Seat Service]]></text>

            </staticText>


            <textField>

                <reportElement
                        x="600"
                        y="8"
                        width="182"
                        height="18"/>

                <textElement
                        textAlignment="Right"
                        verticalAlignment="Middle">

                    <font size="8"/>

                </textElement>

                <textFieldExpression>
                    <![CDATA["Page " + $V{PAGE_NUMBER}]]>
                </textFieldExpression>

            </textField>

        </band>

    </pageFooter>


    <!-- ========================= -->
    <!-- SUMMARY / CHART -->
    <!-- ========================= -->

    <summary>

        <band height="380">


            <staticText>

                <reportElement
                        x="0"
                        y="10"
                        width="782"
                        height="30"/>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                    <font
                            size="15"
                            isBold="true"/>

                </textElement>

                <text><![CDATA[Seat Status Analysis]]></text>

            </staticText>


            <barChart>

                <chart>

                    <reportElement
                            x="30"
                            y="50"
                            width="722"
                            height="290"/>

                    <chartTitle>

                        <font
                                size="12"
                                isBold="true"/>

                    </chartTitle>

                    <chartLegend/>

                </chart>


                <categoryDataset>


                    <!-- AVAILABLE -->

                    <categorySeries>

                        <seriesExpression>
                            <![CDATA["AVAILABLE"]]>
                        </seriesExpression>

                        <categoryExpression>
                            <![CDATA[$F{seatNumber}]]>
                        </categoryExpression>

                        <valueExpression>
                            <![CDATA[
                                new java.lang.Integer(
                                    "AVAILABLE".equals($F{seatStatus})
                                    ? 1
                                    : 0
                                )
                            ]]>
                        </valueExpression>

                    </categorySeries>


                    <!-- HELD -->

                    <categorySeries>

                        <seriesExpression>
                            <![CDATA["HELD"]]>
                        </seriesExpression>

                        <categoryExpression>
                            <![CDATA[$F{seatNumber}]]>
                        </categoryExpression>

                        <valueExpression>
                            <![CDATA[
                                new java.lang.Integer(
                                    "HELD".equals($F{seatStatus})
                                    ? 1
                                    : 0
                                )
                            ]]>
                        </valueExpression>

                    </categorySeries>


                    <!-- BOOKED -->

                    <categorySeries>

                        <seriesExpression>
                            <![CDATA["BOOKED"]]>
                        </seriesExpression>

                        <categoryExpression>
                            <![CDATA[$F{seatNumber}]]>
                        </categoryExpression>

                        <valueExpression>
                            <![CDATA[
                                new java.lang.Integer(
                                    "BOOKED".equals($F{seatStatus})
                                    ? 1
                                    : 0
                                )
                            ]]>
                        </valueExpression>

                    </categorySeries>


                    <!-- BLOCKED -->

                    <categorySeries>

                        <seriesExpression>
                            <![CDATA["BLOCKED"]]>
                        </seriesExpression>

                        <categoryExpression>
                            <![CDATA[$F{seatNumber}]]>
                        </categoryExpression>

                        <valueExpression>
                            <![CDATA[
                                new java.lang.Integer(
                                    "BLOCKED".equals($F{seatStatus})
                                    ? 1
                                    : 0
                                )
                            ]]>
                        </valueExpression>

                    </categorySeries>

                </categoryDataset>


                <barPlot>

                    <plot orientation="Vertical"/>

                    <categoryAxisFormat>

                        <axisFormat
                                verticalTickLabels="false"/>

                    </categoryAxisFormat>

                    <valueAxisFormat>

                        <axisFormat
                                tickLabelMask="0"/>

                    </valueAxisFormat>

                </barPlot>

            </barChart>

        </band>

    </summary>

</jasperReport>