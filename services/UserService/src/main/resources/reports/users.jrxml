<?xml version="1.0" encoding="UTF-8"?>

<jasperReport
        xmlns="http://jasperreports.sourceforge.net/jasperreports"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://jasperreports.sourceforge.net/jasperreports
        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
        name="users"
        pageWidth="842"
        pageHeight="595"
        orientation="Landscape"
        columnWidth="782"
        leftMargin="30"
        rightMargin="30"
        topMargin="25"
        bottomMargin="25">

    <!-- ================= PARAMETERS ================= -->

    <parameter name="REPORT_TITLE" class="java.lang.String"/>

    <!-- ================= FIELDS ================= -->

    <field name="id" class="java.lang.Long"/>
    <field name="fullName" class="java.lang.String"/>
    <field name="email" class="java.lang.String"/>
    <field name="phone" class="java.lang.String"/>
    <field name="userRole" class="com.airlineportal.utils.Users.UserRole"/>
    <field name="lastLogin" class="java.time.LocalDateTime"/>
    <field name="createdAt" class="java.time.LocalDateTime"/>


    <!-- ========================================================= -->
    <!--                         TITLE                              -->
    <!-- ========================================================= -->

    <title>

        <band height="105">
            <!-- Main blue header -->
            <rectangle>
                <reportElement
                        x="0"
                        y="0"
                        width="782"
                        height="70"
                        backcolor="#2563EB"
                        mode="Opaque"/>
            </rectangle>


            <!-- Small decorative strip -->
            <rectangle>
                <reportElement
                        x="0"
                        y="0"
                        width="8"
                        height="70"
                        backcolor="#1E3A8A"
                        mode="Opaque"/>
            </rectangle>


            <!-- Report title -->
            <staticText>
                <reportElement
                        x="25"
                        y="10"
                        width="500"
                        height="32"
                        forecolor="#FFFFFF"/>
                <textElement
                        verticalAlignment="Middle">
                    <font
                            fontName="SansSerif"
                            size="23"
                            isBold="true"/>
                </textElement>

                <text><![CDATA[USER MANAGEMENT REPORT]]></text>
            </staticText>


            <!-- Subtitle -->
            <staticText>
                <reportElement
                        x="25"
                        y="43"
                        width="500"
                        height="20"
                        forecolor="#DBEAFE"/>
                <textElement
                        verticalAlignment="Middle">
                    <font
                            fontName="SansSerif"
                            size="10"/>
                </textElement>
                <text><![CDATA[User directory and account information]]></text>
            </staticText>


            <!-- Report badge -->
            <rectangle>
                <reportElement
                        x="650"
                        y="15"
                        width="105"
                        height="40"
                        backcolor="#1D4ED8"
                        mode="Opaque"/>

            </rectangle>

            <staticText>
                <reportElement
                        x="650"
                        y="15"
                        width="105"
                        height="40"
                        forecolor="#FFFFFF"/>
                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">
                    <font
                            size="10"
                            isBold="true"/>
                </textElement>

                <text><![CDATA[USER REPORT]]></text>
            </staticText>

            <!-- Report subtitle below header -->
            <staticText>
                <reportElement
                        x="0"
                        y="78"
                        width="150"
                        height="20"
                        forecolor="#374151"/>

                <textElement
                        verticalAlignment="Middle">
                    <font
                            size="11"
                            isBold="true"/>
                </textElement>

                <text><![CDATA[Report Summary]]></text>
            </staticText>

            <!-- Blue line -->
            <rectangle>
                <reportElement
                        x="0"
                        y="100"
                        width="782"
                        height="3"
                        backcolor="#2563EB"
                        mode="Opaque"/>
            </rectangle>

        </band>

    </title>


    <!-- ========================================================= -->
    <!--                    COLUMN HEADER                          -->
    <!-- ========================================================= -->

    <columnHeader>
        <band height="40">
            <!-- ID -->
            <rectangle>
                <reportElement
                        x="0"
                        y="0"
                        width="50"
                        height="40"
                        backcolor="#1E40AF"
                        mode="Opaque"/>
            </rectangle>

            <staticText>
                <reportElement
                        x="0"
                        y="0"
                        width="50"
                        height="40"
                        forecolor="#FFFFFF"/>
                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">
                    <font
                            size="9"
                            isBold="true"/>
                </textElement>

                <text><![CDATA[ID]]></text>
            </staticText>

            <!-- FULL NAME -->
            <rectangle>
                <reportElement
                        x="50"
                        y="0"
                        width="140"
                        height="40"
                        backcolor="#1E40AF"
                        mode="Opaque"/>
            </rectangle>

            <staticText>
                <reportElement
                        x="50"
                        y="0"
                        width="140"
                        height="40"
                        forecolor="#FFFFFF"/>
                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">
                    <font
                            size="9"
                            isBold="true"/>
                </textElement>

                <text><![CDATA[FULL NAME]]></text>

            </staticText>


            <!-- EMAIL -->
            <rectangle>
                <reportElement
                        x="190"
                        y="0"
                        width="220"
                        height="40"
                        backcolor="#1E40AF"
                        mode="Opaque"/>
            </rectangle>

            <staticText>
                <reportElement
                        x="190"
                        y="0"
                        width="220"
                        height="40"
                        forecolor="#FFFFFF"/>
                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">
                    <font
                            size="9"
                            isBold="true"/>
                </textElement>

                <text><![CDATA[EMAIL]]></text>
            </staticText>

            <!-- PHONE -->
            <rectangle>
                <reportElement
                        x="410"
                        y="0"
                        width="90"
                        height="40"
                        backcolor="#1E40AF"
                        mode="Opaque"/>
            </rectangle>

            <staticText>
                <reportElement
                        x="410"
                        y="0"
                        width="90"
                        height="40"
                        forecolor="#FFFFFF"/>
                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">
                    <font
                            size="9"
                            isBold="true"/>
                </textElement>

                <text><![CDATA[PHONE]]></text>
            </staticText>

            <!-- ROLE -->
            <rectangle>
                <reportElement
                        x="500"
                        y="0"
                        width="100"
                        height="40"
                        backcolor="#1E40AF"
                        mode="Opaque"/>
            </rectangle>

            <staticText>
                <reportElement
                        x="500"
                        y="0"
                        width="100"
                        height="40"
                        forecolor="#FFFFFF"/>
                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">
                    <font
                            size="9"
                            isBold="true"/>
                </textElement>

                <text><![CDATA[ROLE]]></text>
            </staticText>

            <!-- LAST LOGIN -->
            <rectangle>
                <reportElement
                        x="600"
                        y="0"
                        width="91"
                        height="40"
                        backcolor="#1E40AF"
                        mode="Opaque"/>
            </rectangle>

            <staticText>
                <reportElement
                        x="600"
                        y="0"
                        width="91"
                        height="40"
                        forecolor="#FFFFFF"/>
                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">
                    <font
                            size="8"
                            isBold="true"/>
                </textElement>

                <text><![CDATA[LAST LOGIN]]></text>
            </staticText>

            <!-- CREATED -->
            <rectangle>
                <reportElement
                        x="691"
                        y="0"
                        width="91"
                        height="40"
                        backcolor="#1E40AF"
                        mode="Opaque"/>
            </rectangle>

            <staticText>
                <reportElement
                        x="691"
                        y="0"
                        width="91"
                        height="40"
                        forecolor="#FFFFFF" />
                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">
                    <font
                            size="8"
                            isBold="true"/>
                </textElement>

                <text><![CDATA[CREATED]]></text>
            </staticText>

        </band>
    </columnHeader>


    <!-- ========================================================= -->
    <!--                       DETAIL TABLE                        -->
    <!-- ========================================================= -->

    <detail>

        <band height="38">
            <!-- Alternate row background -->
            <rectangle>
                <reportElement
                        x="0"
                        y="0"
                        width="782"
                        height="38"
                        backcolor="#F8FAFC"
                        mode="Opaque">

                    <printWhenExpression>
                        <![CDATA[$V{REPORT_COUNT} % 2 == 0]]>
                    </printWhenExpression>

                </reportElement>
            </rectangle>


            <!-- ================================================= -->
            <!-- ID                                                -->
            <!-- ================================================= -->

            <textField>
                <reportElement
                        x="0"
                        y="0"
                        width="50"
                        height="38"
                        backcolor="#EFF6FF"
                        mode="Opaque"
                        forecolor="#1D4ED8"/>
                <box>
                    <pen
                            lineWidth="0.5"
                            lineColor="#CBD5E1"/>
                </box>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">
                    <font
                            size="9"
                            isBold="true"/>
                </textElement>

                <textFieldExpression>
                    <![CDATA[$F{id}]]>
                </textFieldExpression>
            </textField>


            <!-- ================================================= -->
            <!-- FULL NAME                                         -->
            <!-- ================================================= -->
            <textField>
                <reportElement
                        x="50"
                        y="0"
                        width="140"
                        height="38"
                        backcolor="#FFFFFF"
                        mode="Opaque"
                        forecolor="#111827"
                />
                <box>
                    <pen
                            lineWidth="0.5"
                            lineColor="#CBD5E1"/>

                </box>
                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">
                    <font
                            size="9"
                            isBold="true"/>
                </textElement>

                <textFieldExpression>
                    <![CDATA[
                    $F{fullName} == null ? "N/A" : $F{fullName}
                    ]]>
                </textFieldExpression>
            </textField>


            <!-- ================================================= -->
            <!-- EMAIL                                             -->
            <!-- ================================================= -->
            <textField>
                <reportElement
                        x="190"
                        y="0"
                        width="220"
                        height="38"
                        backcolor="#FFFFFF"
                        mode="Opaque"
                        forecolor="#374151"
                />

                <box>
                    <pen
                            lineWidth="0.5"
                            lineColor="#CBD5E1"/>

                </box>
                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">
                    <font
                            size="9"/>
                </textElement>

                <textFieldExpression>
                    <![CDATA[
                    $F{email} == null ? "N/A" : $F{email}
                    ]]>
                </textFieldExpression>
            </textField>

            <!-- ================================================= -->
            <!-- PHONE                                             -->
            <!-- ================================================= -->

            <textField>
                <reportElement
                        x="410"
                        y="0"
                        width="90"
                        height="38"
                        backcolor="#FFFFFF"
                        mode="Opaque"
                        forecolor="#374151"
                />
                <box>
                    <pen
                            lineWidth="0.5"
                            lineColor="#CBD5E1"/>

                </box>
                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>

                <textFieldExpression>
                    <![CDATA[
                    $F{phone} == null ? "N/A" : $F{phone}
                    ]]>
                </textFieldExpression>

            </textField>


            <!-- ================================================= -->
            <!-- ROLE                                              -->
            <!-- ================================================= -->

            <textField>
                <reportElement
                        x="500"
                        y="0"
                        width="100"
                        height="38"
                        backcolor="#EEF2FF"
                        mode="Opaque"
                        forecolor="#4338CA"
                />
                <box>
                    <pen
                            lineWidth="0.5"
                            lineColor="#C7D2FE"/>
                </box>
                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">
                    <font
                            size="8"
                            isBold="true"/>
                </textElement>

                <textFieldExpression>
                    <![CDATA[
                    $F{userRole} == null
                    ? "N/A"
                    : $F{userRole}.toString().replace("ROLE_", "")
                    ]]>
                </textFieldExpression>
            </textField>


            <!-- ================================================= -->
            <!-- LAST LOGIN                                        -->
            <!-- ================================================= -->
            <textField
                    pattern="yyyy-MM-dd HH:mm">
                <reportElement
                        x="600"
                        y="0"
                        width="91"
                        height="38"
                        backcolor="#FFFFFF"
                        mode="Opaque"
                        forecolor="#475569"
                />
                <box>
                    <pen
                            lineWidth="0.5"
                            lineColor="#CBD5E1"/>
                </box>
                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">
                    <font size="7"/>
                </textElement>

                <textFieldExpression>
                    <![CDATA[$F{lastLogin}]]>
                </textFieldExpression>
            </textField>


            <!-- ================================================= -->
            <!-- CREATED                                           -->
            <!-- ================================================= -->
            <textField
                    pattern="yyyy-MM-dd HH:mm">
                <reportElement
                        x="691"
                        y="0"
                        width="91"
                        height="38"
                        backcolor="#FFFFFF"
                        mode="Opaque"
                        forecolor="#475569"
                />
                <box>
                    <pen
                            lineWidth="0.5"
                            lineColor="#CBD5E1"/>
                </box>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">
                    <font size="7"/>
                </textElement>

                <textFieldExpression>
                    <![CDATA[$F{createdAt}]]>
                </textFieldExpression>
            </textField>

        </band>

    </detail>


    <!-- ========================================================= -->
    <!--                       PAGE FOOTER                         -->
    <!-- ========================================================= -->

    <pageFooter>

        <band height="50">
            <!-- Footer separator -->

            <line>
                <reportElement
                        x="0"
                        y="5"
                        width="782"
                        height="1"
                        forecolor="#CBD5E1"/>
            </line>

            <!-- Footer left -->
            <staticText>
                <reportElement
                        x="0"
                        y="15"
                        width="350"
                        height="25"
                        forecolor="#64748B"
                />

                <textElement
                        verticalAlignment="Middle">
                    <font
                            size="8"/>
                </textElement>

                <text><![CDATA[Airline Portal • User Management]]></text>
            </staticText>

            <!-- Footer center -->
            <staticText>
                <reportElement
                        x="300"
                        y="15"
                        width="180"
                        height="25"
                        forecolor="#94A3B8"
                />
                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">
                    <font
                            size="8"/>
                </textElement>

                <text><![CDATA[Confidential Report]]></text>
            </staticText>


            <!-- Page number -->
            <textField>
                <reportElement
                        x="650"
                        y="15"
                        width="132"
                        height="25"
                        forecolor="#1E40AF"
                />
                <textElement
                        textAlignment="Right"
                        verticalAlignment="Middle">
                    <font
                            size="9"
                            isBold="true"/>
                </textElement>

                <textFieldExpression>
                    <![CDATA["Page " + $V{PAGE_NUMBER}]]>
                </textFieldExpression>

            </textField>
        </band>

    </pageFooter>

</jasperReport>